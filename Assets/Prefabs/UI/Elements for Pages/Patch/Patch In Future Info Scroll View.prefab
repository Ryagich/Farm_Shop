--- !u!114 &4311968027016677006
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1916088626476469586}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \u0420\u0430\u0434\u0438\u043E\n\u0412 \u0438\u0433\u0440\u0435 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
    \u0440\u0430\u0434\u0438\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043C\u043E\u0436\u043D\u043E
    \u0431\u0443\u0434\u0435\u0442 \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C
    \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u043D\u0438\u044F
    \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u043F\u0435\u0440\u0435\u0434\u0430\u0447.\n2. \u0421\u0438\u0441\u0442\u0435\u043C\u0430
    \u043F\u043E\u043B\u0438\u0432\u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439\n\u0420\u0430\u0441\u0442\u0435\u043D\u0438\u044F
    \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
    \u043F\u043E\u043B\u0438\u0432\u0430\u0442\u044C. \u0411\u0435\u0437 \u043F\u043E\u043B\u0438\u0432\u0430
    \u0438\u0445 \u0440\u043E\u0441\u0442 \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0442\u044C\u0441\u044F
    \u0438\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F.\n3.
    \u041A\u043E\u043C\u043F\u043E\u0441\u0442\u043D\u0430\u044F \u044F\u043C\u0430\n\u041F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432 \u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043E\u0442\u0445\u043E\u0434\u043E\u0432 \u0432 \u043A\u043E\u043C\u043F\u043E\u0441\u0442.\n4.
    \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0443\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u044F
    \u0433\u0440\u044F\u0434\u043E\u043A\n\u0413\u0440\u044F\u0434\u043A\u0438 \u043C\u043E\u0436\u043D\u043E
    \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u043E\u0431\u0440\u044F\u0442\u044C
    \u043A\u043E\u043C\u043F\u043E\u0441\u0442\u043E\u043C. \u0411\u0435\u0437 \u0443\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u044F
    \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0443\u0442 \u0440\u0430\u0441\u0442\u0438.\n5.
    \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430\n\u0411\u0443\u0434\u0443\u0442
    \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u044B \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
    \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F UI-\u0441\u0438\u0441\u0442\u0435\u043C\u044B.
    \u041E\u043D\u0438 \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u044F\u0442 \u0438\u0433\u0440\u043E\u0432\u043E\u0439
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441, \u043D\u043E \u0443\u0441\u043A\u043E\u0440\u044F\u0442
    \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0443\u044E \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0443
    \u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430.\n6. \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0437\u043E\u043D\u0430\n\u0411\u0443\u0434\u0435\u0442 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430
    \u0437\u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043E\u0432\u043E\u0449\u0438 \u0438 \u0444\u0440\u0443\u043A\u0442\u044B \u043C\u043E\u0436\u043D\u043E
    \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
    \u0432 \u043D\u043E\u0432\u044B\u0435 \u0442\u043E\u0432\u0430\u0440\u044B (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043C\u043E\u0440\u043A\u043E\u0432\u044C \u2192 \u043C\u043E\u0440\u043A\u043E\u0432\u043D\u044B\u0439
    \u0441\u043E\u043A).\n7. \u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432 \u0438\u0433\u0440\u043E\u0432\u044B\u0445
    \u0437\u043E\u043D\n\u041F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432
    \u0437\u043E\u043D \u0437\u0430 \u0441\u0447\u0451\u0442 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0439.\n8. \u041D\u043E\u0432\u044B\u0435
    \u0438\u0433\u0440\u043E\u0432\u044B\u0435 \u0437\u043E\u043D\u044B\n\u041F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u043E\u0432\u044B\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0437\u043E\u043D:\n8.1. \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\n8.2.
    \u043A\u0443\u0445\u043D\u044F\n8.3. \u0441\u043A\u043B\u0430\u0434\n\n\u0412\u044B
    \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0442\u044C
    \u0438\u0434\u0435\u0438 \u0434\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0438\u0445
    \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0439 \u0438\u043B\u0438
    \u0441\u043E\u043E\u0431\u0449\u0430\u0442\u044C \u043E \u0431\u0430\u0433\u0430\u0445
    \u0432 \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u044F\u0445
    \u043A \u0438\u0433\u0440\u0435 \u0438\u043B\u0438 \u0432 Telegram-\u043A\u0430\u043D\u0430\u043B\u0435:"
