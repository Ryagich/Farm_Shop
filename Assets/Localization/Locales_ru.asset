      m_Items: []
  - m_Id: 27130050930524160
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 27156260410605568
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 28354470692401152
    m_Localized: "\u0421\u043F\u0438\u0441\u043E\u043A \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439\n1.
      \u0418\u0433\u0440\u043E\u0432\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B\n1.1.
      \u041F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u043D\u0438\u044F \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439\n1.2.
      \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u043B\u043E\u0433\u0438\u043A\u0430
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u043F\u043E\u043B\u043E\u043A\n1.3. \u0422\u0435\u043F\u0435\u0440\u044C \u0434\u043B\u044F
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F
      \u043F\u043E\u043B\u043A\u0430. \u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      \u043F\u043E\u043B\u043A\u0438 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C,
      \u043A\u0430\u043A\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u044B \u0431\u0443\u0434\u0443\u0442
      \u043D\u0430 \u043D\u0435\u0439 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0442\u044C\u0441\u044F\n1.4.
      \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0445 \u0442\u043E\u0432\u0430\u0440\u043E\u0432
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0435\n1.5. \u0421\u0438\u0441\u0442\u0435\u043C\u0430
      \u0433\u0440\u044F\u0434\u043E\u043A \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u0430:
      \u0433\u0440\u044F\u0434\u043A\u0438 \u0438 \u0441\u0435\u043C\u0435\u043D\u0430
      \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u044E\u0442\u0441\u044F
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E, \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C,
      \u043A\u0430\u043A\u043E\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u044C\n1.6. \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u044F
      \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u044B \u043D\u0430 \u0442\u0438\u043F\u044B.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0442\u0438\u043F \u043C\u043E\u0436\u043D\u043E
      \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
      \u0433\u0440\u044F\u0434\u043A\u0435\n1.7. \u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
      \u043F\u0440\u0438 \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0435
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0435 \u043C\u0435\u0441\u0442\u043E\n1.8.
      \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D \u043D\u043E\u0432\u044B\u0439
      \u0442\u0438\u043F \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u2014 \u0434\u043B\u044F
      \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043D\u0430\u0436\u0430\u0442\u0438\u0435
      \u043A\u043D\u043E\u043F\u043A\u0438\n1.9.\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430
      \u0434\u043E\u0441\u043A\u0430 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0439\n\n2.
      \u0411\u0430\u043B\u0430\u043D\u0441 \u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430\n2.1.
      \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u044B \u0446\u0435\u043D\u044B
      \u043D\u0430 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B\n\n3. \u0412\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435
      \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\n3.1. \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u044B
      \u0438\u043A\u043E\u043D\u043A\u0438 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439,
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432 \u0438 \u0433\u0440\u044F\u0434\u043E\u043A\n3.2.
      \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D \u0432\u0438\u0437\u0443\u0430\u043B
      \u0433\u0440\u044F\u0434\u043E\u043A\n\n4. \u0417\u0432\u0443\u043A\n4.1. \u0412\u044B\u0440\u043E\u0432\u043D\u0435\u043D
      \u0437\u0432\u0443\u043A \u0448\u0430\u0433\u043E\u0432\n4.2. \u0423\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0430
      \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u0437\u0432\u0443\u043A\u0430
      \u0441\u043A\u0430\u043D\u0435\u0440\u0430 \u043A\u0430\u0441\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 28379935339589632
    m_Localized: "\u0411\u0443\u0434\u0443\u0449\u0438\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 28556219701297152
    m_Localized: "1. \u0420\u0430\u0434\u0438\u043E\n\u0412 \u0438\u0433\u0440\u0435
      \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u0440\u0430\u0434\u0438\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
      \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u043D\u0438\u044F
      \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
      \u043F\u0435\u0440\u0435\u0434\u0430\u0447.\n2. \u0421\u0438\u0441\u0442\u0435\u043C\u0430
      \u043F\u043E\u043B\u0438\u0432\u0430 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439\n\u0420\u0430\u0441\u0442\u0435\u043D\u0438\u044F
      \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
      \u043F\u043E\u043B\u0438\u0432\u0430\u0442\u044C. \u0411\u0435\u0437 \u043F\u043E\u043B\u0438\u0432\u0430
      \u0438\u0445 \u0440\u043E\u0441\u0442 \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0442\u044C\u0441\u044F
      \u0438\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F.\n3.
      \u041A\u043E\u043C\u043F\u043E\u0441\u0442\u043D\u0430\u044F \u044F\u043C\u0430\n\u041F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432 \u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u043E\u0442\u0445\u043E\u0434\u043E\u0432 \u0432 \u043A\u043E\u043C\u043F\u043E\u0441\u0442.\n4.
      \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0443\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u044F
      \u0433\u0440\u044F\u0434\u043E\u043A\n\u0413\u0440\u044F\u0434\u043A\u0438
      \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u043E\u0431\u0440\u044F\u0442\u044C
      \u043A\u043E\u043C\u043F\u043E\u0441\u0442\u043E\u043C. \u0411\u0435\u0437
      \u0443\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0443\u0442
      \u0440\u0430\u0441\u0442\u0438.\n5. \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430\n\u0411\u0443\u0434\u0443\u0442
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u044B \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F UI-\u0441\u0438\u0441\u0442\u0435\u043C\u044B.
      \u041E\u043D\u0438 \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u044F\u0442
      \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441,
      \u043D\u043E \u0443\u0441\u043A\u043E\u0440\u044F\u0442 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0443\u044E
      \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0443 \u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u0442
      \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430.\n6.
      \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0437\u043E\u043D\u0430\n\u0411\u0443\u0434\u0435\u0442 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430
      \u0437\u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u043E\u0432\u043E\u0449\u0438 \u0438 \u0444\u0440\u0443\u043A\u0442\u044B
      \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
      \u0432 \u043D\u043E\u0432\u044B\u0435 \u0442\u043E\u0432\u0430\u0440\u044B
      (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043C\u043E\u0440\u043A\u043E\u0432\u044C
      \u2192 \u043C\u043E\u0440\u043A\u043E\u0432\u043D\u044B\u0439 \u0441\u043E\u043A).\n7.
      \u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432
      \u0438\u0433\u0440\u043E\u0432\u044B\u0445 \u0437\u043E\u043D\n\u041F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432 \u0437\u043E\u043D \u0437\u0430
      \u0441\u0447\u0451\u0442 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0439.\n8.
      \u041D\u043E\u0432\u044B\u0435 \u0438\u0433\u0440\u043E\u0432\u044B\u0435 \u0437\u043E\u043D\u044B\n\u041F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0441\u044F
